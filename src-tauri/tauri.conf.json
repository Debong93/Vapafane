{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Redcraftserver",
  "version": "0.2.0",
  "identifier": "de.debong93.redcraftserver",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Redcraftserver",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Minecraft-Serververwaltung",
    "longDescription": "Redcraftserver startet, stoppt und überwacht einen Minecraft-Server, macht Backups und hilft bei Updates.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "languages": ["German"], "installMode": "currentUser" },
      "wix": { "language": "de-DE" }
    }
  }
}
