{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vapafane",
  "version": "0.10.0",
  "identifier": "de.debong93.vapafane",
  "build": {
    "frontendDist": "../frontend/dist",
    "beforeBuildCommand": {
      "script": "trunk build --release",
      "cwd": "../frontend"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vapafane",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.modrinth.com https://media.forgecdn.net"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "publisher": "Debong93",
    "copyright": "© 2026 Debong93 · MIT license",
    "homepage": "https://github.com/Debong93/Vapafane",
    "shortDescription": "Minecraft workbench for server & client",
    "longDescription": "Vapafane – Minecraft workbench for server & client: run, back up and update servers with Vanilla, Paper, Fabric or NeoForge, install mods – and invite friends with an invite code that sets up their Minecraft automatically. In 9 languages.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "vapafane.desktop",
        "section": "games"
      }
    },
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "German",
          "French",
          "Spanish",
          "Italian",
          "Dutch",
          "Portuguese",
          "Polish",
          "Turkish"
        ],
        "installMode": "currentUser"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
