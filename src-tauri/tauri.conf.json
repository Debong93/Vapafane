{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vapafane",
  "version": "0.4.1",
  "identifier": "de.debong93.vapafane",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vapafane – das Minecraft-Servertool",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.modrinth.com https://media.forgecdn.net"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Vapafane – das Minecraft-Servertool",
    "longDescription": "Vapafane – das Minecraft-Servertool für Vanilla, Paper, Fabric und NeoForge: startet, stoppt und überwacht den Server, macht Backups, hilft bei Updates und installiert Mods.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "German"
        ],
        "installMode": "currentUser"
      },
      "wix": {
        "language": "de-DE"
      }
    }
  }
}
